<?xml version="1.0"?>
<sdf version="1.9">
  <world name="baseline">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>30 20 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>30 20 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.34 0.36 1</ambient>
            <diffuse>0.40 0.42 0.44 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Fixed reference objects make the LiDAR view and rover motion legible. -->
    <model name="reference_block_east">
      <static>true</static>
      <pose>2.8 2.0 0.35 0 0 0</pose>
      <link name="block_link">
        <collision name="block_collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="block_visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.55 0.18 0.08 1</ambient><diffuse>0.75 0.25 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reference_block_west">
      <static>true</static>
      <pose>-2.5 -2.4 0.50 0 0 0</pose>
      <link name="block_link">
        <collision name="block_collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="block_visual">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.08 0.42 0.25 1</ambient><diffuse>0.10 0.60 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reference_marker_north">
      <static>true</static>
      <pose>0 3.4 0.6 0 0 0</pose>
      <link name="marker_link">
        <collision name="marker_collision"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="marker_visual">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.75 0.70 0.08 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://hil_rover</uri>
      <name>hil_rover</name>
      <pose>-2.0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
