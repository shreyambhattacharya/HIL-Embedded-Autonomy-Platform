<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hil_rover">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <static>false</static>

    <!-- Main chassis: x forward, y left, z up. -->
    <link name="base_link">
      <pose>0 0 0.32 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.2723</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.4589</iyy>
          <iyz>0</iyz>
          <izz>0.6667</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.80 0.60 0.22</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.80 0.60 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.24 0.42 1</ambient>
          <diffuse>0.16 0.35 0.65 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- The sphere center is 0.24 m below the base-link origin, placing
           its lowest point on the nominal z=0 ground plane. -->
      <collision name="front_support_collision">
        <pose>0.30 0 -0.24 0 0 0</pose>
        <geometry>
          <sphere><radius>0.08</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.15</mu><mu2>0.15</mu2></ode>
            <bullet><friction>0.15</friction><friction2>0.15</friction2></bullet>
          </friction>
        </surface>
      </collision>
      <visual name="front_support_visual">
        <pose>0.30 0 -0.24 0 0 0</pose>
        <geometry>
          <sphere><radius>0.08</radius></sphere>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.43 0.18 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.0039</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0073</iyy>
          <iyz>0</iyz>
          <izz>0.0039</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
            <bullet>
              <friction>0.9</friction>
              <friction2>0.9</friction2>
            </bullet>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.43 0.18 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.0039</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0073</iyy>
          <iyz>0</iyz>
          <izz>0.0039</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
            <bullet>
              <friction>0.9</friction>
              <friction2>0.9</friction2>
            </bullet>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <link name="caster_link">
      <pose>-0.30 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.15</mu>
              <mu2>0.15</mu2>
            </ode>
            <bullet>
              <friction>0.15</friction>
              <friction2>0.15</friction2>
            </bullet>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="imu_link">
      <pose>0 0 0.49 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>/hil/gz/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <link name="lidar_link">
      <pose>0.25 0 0.53 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.1 1</ambient>
          <diffuse>0.9 0.9 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="planar_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/hil/gz/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415927</min_angle>
              <max_angle>3.1415927</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="left_wheel"/>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <!-- Positive joint speed produces +x travel for this wheel geometry. -->
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <effort>1.5</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="right_wheel"/>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <effort>1.5</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Direct external effort interface; no Gazebo DiffDrive controller. -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_wheel_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/hil/gz/wheel_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/hil/gz/ground_truth/odom</odom_topic>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
