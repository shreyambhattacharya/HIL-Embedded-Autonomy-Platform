<?xml version="1.0"?>
<sdf version="1.9">
  <world name="autonomy_obstacle">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><box><size>30 20 0.10</size></box></geometry></collision>
        <visual name="ground_visual">
          <geometry><box><size>30 20 0.10</size></box></geometry>
          <material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>
    <!-- Static obstacle lies on the first +x waypoint leg from the rover start. -->
    <model name="autonomy_stop_obstacle">
      <static>true</static>
      <pose>-0.85 0 0.35 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision"><geometry><box><size>0.50 0.90 0.70</size></box></geometry></collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.50 0.90 0.70</size></box></geometry>
          <material><ambient>0.70 0.12 0.08 1</ambient><diffuse>0.90 0.18 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://hil_rover</uri>
      <name>hil_rover</name>
      <pose>-2.0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
